# Local PostgreSQL 16 from compose.yaml. Development credentials only.
DATABASE_URL=postgresql://rachie_peggie_dev:local_development_only@127.0.0.1:55439/rachie_peggie_dev
ALLOW_DEVELOPMENT_DATABASE_SEED=true

# Explicit acknowledgement required whenever the reviewed operator bootstrap runs.
# Keep unset on the web service; set only for the one-shot operator command.
BOOKING_BOOTSTRAP_ENABLED=

# Trust Railway's edge-injected X-Forwarded-Host and X-Real-IP headers only
# when explicitly enabled in a Railway deployment.
TRUSTED_PROXY=

# Generate a local value with: openssl rand -base64 48
AUTH_SESSION_SECRET=replace-with-at-least-32-random-bytes

# Copy these from the R.A.C.H.I.E application in the Discord Developer Portal.
RACHIE_DISCORD_OAUTH_CLIENT_ID=replace-with-rachie-client-id
RACHIE_DISCORD_OAUTH_CLIENT_SECRET=replace-with-rachie-client-secret
RACHIE_DISCORD_BOT_TOKEN=replace-with-rachie-bot-token
RACHIE_DISCORD_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback

# Copy these from the P.E.G.G.I.E application in the Discord Developer Portal.
PEGGIE_DISCORD_OAUTH_CLIENT_ID=replace-with-peggie-client-id
PEGGIE_DISCORD_OAUTH_CLIENT_SECRET=replace-with-peggie-client-secret
PEGGIE_DISCORD_BOT_TOKEN=replace-with-peggie-bot-token
PEGGIE_DISCORD_OAUTH_REDIRECT_URI=http://peggie.localhost:3000/api/v1/auth/callback

# Real development Discord guild IDs. Your OAuth test user must belong to them.
WOS_DEV_DISCORD_GUILD_ID=replace-with-wos-development-guild-id
KINGSHOT_DEV_DISCORD_GUILD_ID=replace-with-kingshot-development-guild-id

# Optional legacy Apps Script compatibility proxies. Treat populated URLs as secrets.
RACHIE_LEGACY_BOOKING_URL=
PEGGIE_LEGACY_BOOKING_URL=

# Obsolete development-only bridge used by isolated service tests, not authenticated routes.
WOS_NATIVE_BOOKING_COMMUNITY_CODE=
KINGSHOT_NATIVE_BOOKING_COMMUNITY_CODE=

# Optional disposable integration-test database. Never use staging or production.
TEST_DATABASE_URL=
