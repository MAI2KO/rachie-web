{
  "name": "rachie-peggie-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down --volumes",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:bootstrap": "node --env-file-if-exists=.env.local scripts/bootstrap-booking-community.mjs",
    "db:bootstrap-config": "node scripts/bootstrap-booking-community-config.mjs",
    "db:booking-window": "node --env-file-if-exists=.env.local scripts/booking-window.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed-development.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "next": "16.3.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
