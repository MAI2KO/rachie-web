    "displayName": "<public-community-name>",
    "discordGuild": {
      "id": "<discord-guild-id>",
      "displayName": "<public-discord-guild-name>"
    }
  },
  "booking": {
    "enabled": true,
    "open": false
  },
  "timeZone": "<IANA-time-zone>",
