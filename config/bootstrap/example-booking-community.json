      "slots": [
        {
          "displayTimeLabel": "<public-time-label>",
          "localStartTime": "<HH:MM>"
        }
      ]
    },
    {
      "code": "troop",
      "bookingDate": "<YYYY-MM-DD>",
      "requirements": ["speedups"],
      "slots": [
        {
          "displayTimeLabel": "<public-time-label>",
          "localStartTime": "<HH:MM>"
        }
      ]
    }
  ]
}
